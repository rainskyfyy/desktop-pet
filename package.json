{
    "name": "luoxiaohei-pet",
    "version": "1.0.0",
    "description": "罗小黑桌面宠物 - Windows 桌面端",
    "author": "luoxiaohei",
    "main": "main.js",
    "scripts": {
        "start": "electron .",
        "build": "electron-builder",
        "build:win": "set ELECTRON_MIRROR=https://npmmirror.com/mirrors/electron/&& set ELECTRON_BUILDER_BINARIES_MIRROR=https://npmmirror.com/mirrors/electron-builder-binaries/&& set ELECTRON_BUILDER_CACHE=.cache&& electron-builder --win"
    },
    "devDependencies": {
        "electron": "^28.0.0",
        "electron-builder": "^24.0.0"
    },
    "build": {
        "appId": "com.luoxiaohei.pet",
        "productName": "luoxiaohei-pet",
        "directories": {
            "output": "dist"
        },
        "files": [
            "main.js",
            "preload.js",
            "index.html",
            "*.png"
        ],
        "win": {
            "target": "nsis",
            "icon": null
        },
        "nsis": {
            "oneClick": false,
            "allowToChangeInstallationDirectory": true
        },
        "electronDownload": {
            "mirror": "https://npmmirror.com/mirrors/electron/"
        }
    }
}
